@startuml
!include <C4/C4_Container>
skinparam defaultFontName Arial
skinparam dpi 130
LAYOUT_TOP_DOWN()
title C4 Container Diagram de Talki: arquitectura objetivo por contextos
Person(student, "Estudiante", "Prepara y realiza prácticas")
Person(tutor, "Tutor / profesor", "Acceso temporal al reporte")
System_Ext(gemini, "Gemini Live", "Voz y transcripción autorizada")
System_Ext(mail, "Correo propuesto", "Cuenta y privacidad")
System_Boundary(talki, "Talki: contenedores de la arquitectura objetivo") {
Container(web, "Cliente web", "Next.js / React", "Configuración, conversación y consulta de resultados")
Container(mobile, "Cliente móvil propuesto", "Flutter", "Versión móvil del mismo recorrido")
Container(gateway, "API Gateway / BFF propuesto", "HTTPS / JSON", "Enruta peticiones y aplica políticas comunes")
Container(identity, "Identity & Access", "Java / Spring Boot", "Cuenta, credenciales y propiedad")
Container(sessions, "Practice Session Management", "Java / Spring Boot", "Ciclo de vida y evidencia del ensayo")
Container(live, "Live Coaching", "Java / Spring Boot", "Modos, credencial efímera y cierre")
Container(analysis, "Speech Analysis Worker", "Java / Spring Boot", "Analiza transcripción y publica métricas")
Container(scoring, "Scoring & Feedback Worker", "Java / Spring Boot", "Evalúa, conserva y versiona el reporte")
Container(progress, "Progress & Adaptation", "Java / Spring Boot", "Resumen y comparación de progreso")
Container(game, "Gamification", "Java / Spring Boot", "Rachas y logros")
Container(sharing, "Sharing & Retention propuesto", "Java / Spring Boot", "Permisos temporales y purga")
Container(ai, "AI Provider Gateway propuesto", "Java / Spring Boot", "Aísla preparación de integración con proveedor")
Container(notifications, "Notifications", "Java / Spring Boot", "Recibe eventos; entrega WSS/correo propuesta")
ContainerQueue(bus, "Broker de eventos", "RabbitMQ / AMQP", "Colas, confirmaciones, reintentos y cola de fallos")
ContainerDb(coredata, "Datos de cuenta y práctica", "PostgreSQL / TLS", "Esquemas privados de Identity y Sessions")
ContainerDb(resultdata, "Datos de evaluación y evolución", "PostgreSQL / TLS", "Esquemas privados de Scoring, Progress y Gamification")
ContainerDb(privacydata, "Datos de privacidad propuestos", "PostgreSQL / TLS", "Permisos, solicitudes y confirmaciones de Sharing")
}
Rel(student, web, "Configura ensayos y revisa feedback", "HTTPS")
Rel(student, mobile, "Realiza el recorrido móvil", "HTTPS; propuesto")
Rel(tutor, web, "Consulta reporte con enlace vigente", "HTTPS")
Rel(web, gateway, "Solicita operaciones y consulta estados", "HTTPS / JSON")
Rel(mobile, gateway, "Solicita las mismas operaciones", "HTTPS / JSON; propuesto")
Rel(web, gemini, "Intercambia voz con credencial efímera", "WSS")
Rel(mobile, gemini, "Intercambia voz autorizada", "WSS; propuesto")
Rel(gateway, identity, "Autentica y consulta perfil", "HTTPS / JSON")
Rel(gateway, sessions, "Crea, consulta y finaliza sesiones", "HTTPS / JSON")
Rel(gateway, live, "Solicita token y entrega evidencia de cierre", "HTTPS / JSON")
Rel(gateway, scoring, "Consulta reporte y estado", "HTTPS / JSON; ampliación")
Rel(gateway, progress, "Consulta evolución", "HTTPS / JSON")
Rel(gateway, game, "Consulta rachas y ranking", "HTTPS / JSON")
Rel(gateway, sharing, "Comparte, revoca y elimina", "HTTPS / JSON; propuesto")
Rel(live, ai, "Solicita preparación de la integración", "HTTPS / JSON; ACL propuesta")
Rel(ai, gemini, "Obtiene credencial temporal", "HTTPS; adaptador propuesto")
Rel(live, bus, "Publica session.live.finalized", "AMQP")
Rel(bus, analysis, "Entrega session.live.finalized", "AMQP")
Rel(analysis, bus, "Publica fillers.analyzed", "AMQP")
Rel(bus, scoring, "Entrega fillers.analyzed", "AMQP")
Rel(scoring, bus, "Publica scoring.completed", "AMQP")
Rel(bus, progress, "Entrega scoring.completed", "AMQP")
Rel(bus, game, "Entrega scoring.completed", "AMQP")
Rel(game, bus, "Publica achievement.unlocked", "AMQP")
Rel(identity, bus, "Publica user.registered", "AMQP")
Rel(bus, sessions, "Entrega user.registered para proyección local", "AMQP")
Rel(sharing, bus, "Coordina purga y confirmaciones", "AMQP; propuesto")
Rel(bus, notifications, "Entrega eventos de evaluación y logro", "AMQP")
Rel(notifications, web, "Entrega avisos autenticados", "WSS; propuesto")
Rel(notifications, mail, "Envía avisos de cuenta y privacidad", "HTTPS / SMTP-TLS; propuesto")
Rel(identity, coredata, "Lee y escribe su esquema privado", "SQL / TLS")
Rel(sessions, coredata, "Lee y escribe su esquema privado", "SQL / TLS")
Rel(scoring, resultdata, "Conserva evaluaciones en su esquema", "SQL / TLS")
Rel(progress, resultdata, "Actualiza resumen en su esquema", "SQL / TLS")
Rel(game, resultdata, "Conserva rachas en su esquema", "SQL / TLS")
Rel(sharing, privacydata, "Conserva permisos y solicitudes", "SQL / TLS; propuesto")
SHOW_LEGEND()
@enduml
