@startuml
!include <C4/C4_Container>
skinparam defaultFontName Arial
skinparam dpi 150
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 65
skinparam ArrowFontSize 12
LAYOUT_TOP_DOWN()
title C4 Container: acceso y operaciones principales
Person(early, "Estudiante de ciclos 1 a 5", "Ensaya exposiciones y revisa feedback propio")
Person(advanced, "Estudiante de ciclos 6 a 10", "Prepara entrevistas y sustentaciones contextualizadas")
System_Boundary(talki, "Talki") {
Container(web, "Cliente web", "Angular / Angular Material", "Configuración, conversación y consulta de resultados")
Container(mobile, "Cliente móvil propuesto", "Flutter", "Versión móvil del mismo recorrido")
Container(gateway, "API Gateway / BFF propuesto", "HTTPS / JSON", "Enruta peticiones y aplica políticas comunes")
Container(identity, "Identity & Access", "Java / Spring Boot", "Cuenta, credenciales y propiedad")
Container(sessions, "Practice Session Management", "Java / Spring Boot", "Ciclo de vida y evidencia del ensayo")
Container(live, "Live Coaching", "Java / Spring Boot", "Modos, credencial efímera y cierre")
Container(scoring, "Scoring & Feedback Worker", "Java / Spring Boot", "Evalúa, conserva y versiona el reporte")
}
Rel(early, web, "Ensaya exposiciones", "HTTPS")
Rel(advanced, web, "Prepara simulaciones", "HTTPS")
Rel(early, mobile, "Practica desde móvil", "HTTPS; propuesto")
Rel(advanced, mobile, "Practica desde móvil", "HTTPS; propuesto")
Rel(web, gateway, "Solicita operaciones", "HTTPS / JSON")
Rel(mobile, gateway, "Solicita operaciones", "HTTPS / JSON; propuesto")
Rel(gateway, identity, "Cuenta y perfil", "HTTPS / JSON")
Rel(gateway, sessions, "Sesiones", "HTTPS / JSON")
Rel(gateway, live, "Práctica en vivo", "HTTPS / JSON")
Rel(gateway, scoring, "Reporte y estado", "HTTPS / JSON")
Lay_R(early, advanced)
Lay_R(web, mobile)
Lay_R(identity, sessions)
Lay_R(live, scoring)
Lay_D(identity, live)
Lay_D(sessions, scoring)
SHOW_LEGEND()
@enduml
