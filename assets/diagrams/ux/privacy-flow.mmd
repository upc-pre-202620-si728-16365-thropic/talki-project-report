flowchart TD
  owner["Estudiante propietario"] --> action{"Acción"}
  action -- Exportar --> check{"Sesión propia y accesible?"}
  check -- Sí --> file["Descargar transcripción y feedback autorizados"]
  check -- No --> deny["Denegar descarga sin entregar datos"]
  action -- "Retirar consentimiento" --> withdraw["Detener nuevo procesamiento del alcance retirado"]
  action -- Eliminar --> confirm["Confirmar consecuencia"]
  confirm --> tombstone["Bloquear consulta y exportación"]
  tombstone --> purge["Propagar orden a contextos propietarios"]
  purge --> receipts{"Seis confirmaciones de purga?"}
  receipts -- No --> pending["Purga pendiente / reintento"]
  pending --> purge
  receipts -- Sí --> done["Confirmar datos purgados"]
