flowchart TB
  input["Interface: compartir, revocar, exportar y eliminar"] --> sharing["Application: casos de uso de compartir y exportar"]
  input --> deletion["Application: solicitud y seguimiento de eliminación"]
  sharing --> grant["Domain: ShareGrant"]
  deletion --> request["Domain: DeletionRequest y PurgeReceipt"]
  grant --> repo["Infrastructure: repositorios de permisos y solicitudes"]
  request --> repo
  repo --> db["PostgreSQL: permisos, solicitudes y confirmaciones"]
  deletion --> broker["Infrastructure: RabbitMQ"]
  broker --> owners["Contextos propietarios: eliminar y confirmar"]
  owners --> deletion
  note["Modelo propuesto"] -.-> input
