erDiagram
    USER_PROGRESS ||--o{ SESSION_METRICS : evidencia
    USER_PROGRESS ||--o{ ADAPTIVE_PLANS : planes
    ADAPTIVE_PLANS ||--|{ PRACTICE_EXERCISES : ejercicios
    USER_PROGRESS {
        bigint user_id PK
        int total_sessions
        int total_minutes
    }
    SESSION_METRICS {
        uuid id PK
        uuid session_id
        bigint user_id FK
        varchar mode
        int duration_seconds
        int overall
        jsonb scores
        varchar analysis_version
        varchar rubric_version
        timestamp occurred_at
    }
    ADAPTIVE_PLANS {
        uuid id PK
        bigint user_id FK
        varchar rule_version
        jsonb evidence_ids
        timestamp created_at
    }
    PRACTICE_EXERCISES {
        uuid id PK
        uuid plan_id FK
        varchar goal
        text instruction
        int duration_seconds
        boolean completed
    }
