@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam componentStyle uml2
skinparam backgroundColor white
skinparam componentBackgroundColor #EAF0FF
skinparam componentBorderColor #1749B5
skinparam ArrowColor #536177
skinparam packageBackgroundColor #F7F9FD
skinparam dpi 130
title
UML Component Diagram: Scoring & Feedback
Descomposición en Scoring Worker (Java / Spring Boot)
end title
queue "Contrato de entrada:\nfillers.analyzed" as input <<Externo>> #EEEEEE
database "PostgreSQL:\nscore_results" as db <<Externo>> #EEEEEE
queue "RabbitMQ:\nscoring.completed" as broker <<Externo>> #EEEEEE
component "Progress, Gamification\ny Notifications" as next <<Externo>> #EEEEEE
package "Bounded Context:\nScoring & Feedback" {
  package "Application Layer" {
    component "Application:\nevaluar\ny registrar resultado\n[Java / Spring Boot]" as app
  }
  package "Domain Layer" {
    component "Domain:\nScoreCalculator\n[Java / Spring Boot]" as calculator
    component "Domain:\nScoreResult\ny VoiceScore\n[Java / Spring Boot]" as score
  }
  package "Infrastructure Layer" {
    component "Infrastructure:\nFillerAnalyzedConsumer\n[Java / Spring Boot]" as listener
    component "Infrastructure:\nScoreResultRepository\n[Java / Spring Boot]" as repo
    component "Infrastructure:\nScoringCompletedPublisher\n[Java / Spring Boot]" as pub
  }
}
input --> listener : eventos / AMQP
listener --> app : activa evaluación / Java
app --> calculator : solicita puntuación / Java
calculator --> score : produce VoiceScore / Java
app --> repo : conserva evaluación / Java
repo --> db : persistencia / SQL
app --> pub : solicita publicación del resultado / Java
pub --> broker : eventos / AMQP
broker --> next : eventos / AMQP
legend bottom
Icono UML: componente; círculo: interfaz.
Flecha continua: interacción dirigida.
Relación a interfaz: contrato proporcionado.
Externo: fuera del proceso representado.
Propuesto: ampliación pendiente.
Los casos de uso nombran responsabilidades de diseño;
no acreditan nuevas clases ni servicios desplegados.
endlegend
@enduml
