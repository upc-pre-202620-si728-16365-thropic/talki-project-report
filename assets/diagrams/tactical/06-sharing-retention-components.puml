@startuml
!include <C4/C4_Component>
skinparam defaultFontName Arial
skinparam dpi 150
LAYOUT_TOP_DOWN()
title C4 Component Diagram: Sharing & Retention
Container(bff, "API Gateway / BFF", "HTTPS / JSON", "Fuera del container representado")
ContainerQueue(bus, "Broker de eventos", "RabbitMQ / AMQP", "Fuera del container representado")
ContainerDb(db, "Esquema privado del contexto", "PostgreSQL / TLS", "Fuera del container representado")
Container(scoring, "Scoring & Feedback Worker", "Java / Spring Boot", "Fuera del container representado")
Container(sessions, "Practice Session Management", "Java / Spring Boot", "Fuera del container representado")
Container_Boundary(scope, "Sharing & Retention: proceso Java / Spring Boot") {
  Component(api, "ShareController / DeletionController / ExportController", "Java / Spring Boot", "Interface: Recibe solicitudes de privacidad y lectura compartida")
  Component(app, "CreateShareGrantHandler / ResolveSharedReportHandler / RevokeShareHandler / RequestDeletionHandler / CollectPurgeReceiptHandler / ExportReportHandler", "Java / Spring Boot", "Application: Autoriza consultas y coordina permisos, exportación y purga")
  Component(rules, "ShareGrant / DeletionRequest / PurgeReceipt", "Java / Spring Boot", "Domain: Controla vigencia, bloqueo y confirmaciones")
  Component(repo, "ShareGrantRepository / DeletionRequestRepository", "Java / Spring Boot", "Infrastructure: Conserva hashes, solicitudes y confirmaciones")
  Component(messaging, "DeletionPublisher / PurgeReceiptConsumer", "Java / Spring Boot", "Infrastructure: Solicita purga y recibe confirmaciones")
  Component(clients, "SessionAccessClient / AuthorizedReportClient", "Java / Spring Boot", "Infrastructure: Bloquea sesión y recupera únicamente el reporte autorizado")
}
Rel(api, app, "Delega caso de uso", "Java")
Rel(messaging, app, "Entrega evento validado", "Java")
Rel(app, rules, "Aplica reglas de dominio", "Java")
Rel(app, repo, "Lee y confirma datos del contexto", "Java")
Rel(app, clients, "Comprueba acceso y recupera reporte", "Java")
Rel(app, messaging, "Registra salida o confirmación", "Java")
Rel(bff, api, "Comparte, revoca, exporta o elimina", "HTTPS / JSON")
Rel(repo, db, "Conserva permisos y solicitudes", "SQL / TLS")
Rel(messaging, bus, "Publica deletion.requested", "AMQP")
Rel(bus, messaging, "Entrega purge.completed", "AMQP")
Rel(clients, sessions, "Verifica propiedad y bloquea acceso", "HTTPS / JSON")
Rel(clients, scoring, "Consulta reporte autorizado", "HTTPS / JSON")
SHOW_LEGEND()
@enduml
