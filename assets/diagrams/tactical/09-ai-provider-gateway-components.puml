@startuml
!include <C4/C4_Component>
skinparam defaultFontName Arial
skinparam dpi 150
LAYOUT_TOP_DOWN()
title C4 Component Diagram: AI Provider Gateway
System_Ext(gemini, "Gemini Live", "API de credenciales; voz directa cliente")
Container(live, "Live Coaching", "Java / Spring Boot", "Fuera del container representado")
Container_Boundary(scope, "AI Provider Gateway: proceso Java / Spring Boot") {
  Component(api, "AIProviderGatewayController", "Java / Spring Boot", "Interface: Recibe contrato interno de credenciales")
  Component(app, "AIIntegrationApplicationService", "Java / Spring Boot", "Application: Comprueba capacidad y selecciona proveedor")
  Component(rules, "AIProviderPort / LivePreparation / LiveCredential", "Java / Spring Boot", "Domain: Define preparación independiente del proveedor")
  Component(adapter, "GeminiLiveClient", "Java / Spring Boot", "Infrastructure: Emite credencial efímera por HTTPS")
  Component(config, "ProviderConfiguration", "Java / Spring Boot", "Infrastructure: Obtiene secretos y capacidades de configuración protegida")
}
Rel(api, app, "Delega caso de uso", "Java")
Rel(app, rules, "Aplica reglas de dominio", "Java")
Rel(app, adapter, "Solicita credencial al proveedor", "Java")
Rel(app, config, "Obtiene configuración protegida", "Java")
Rel(live, api, "Solicita preparación de credencial", "HTTPS / JSON")
Rel(adapter, gemini, "Obtiene credencial efímera", "HTTPS")
SHOW_LEGEND()
@enduml
