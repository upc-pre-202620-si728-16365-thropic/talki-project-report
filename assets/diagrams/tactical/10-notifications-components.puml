@startuml
!include <C4/C4_Component>
skinparam defaultFontName Arial
skinparam dpi 150
LAYOUT_TOP_DOWN()
title C4 Component Diagram: Notifications
Container(bff, "API Gateway / BFF", "HTTPS / JSON", "Fuera del container representado")
ContainerQueue(bus, "Broker de eventos", "RabbitMQ / AMQP", "Fuera del container representado")
ContainerDb(db, "Esquema privado del contexto", "PostgreSQL / TLS", "Fuera del container representado")
System_Ext(mail, "Proveedor de correo", "Canal transaccional propuesto")
Container(identity, "Identity & Access", "Java / Spring Boot", "Contrato interno protegido de enlaces de cuenta")
Container(web, "Cliente web / móvil", "Navegador / Flutter", "Fuera del container representado")
Container_Boundary(scope, "Notifications: proceso Java / Spring Boot") {
  Component(consumer, "NotificationEventConsumer", "Java / Spring Boot", "Infrastructure: Recibe eventos de evaluación, logro, cuenta y privacidad")
  Component(api, "NotificationPreferenceController", "Java / Spring Boot", "Interface: Expone preferencias del destinatario")
  Component(app, "DispatchNotificationHandler / NotificationTemplateService / NotificationPreferenceService / NotificationRetryHandler", "Java / Spring Boot", "Application: Prepara contenido, respeta preferencias y coordina reintento")
  Component(rules, "Notification / NotificationPreference / NotificationPushService", "Java / Spring Boot", "Domain: Mantiene estado y contrato de entrega")
  Component(ports, "NotificationRepository / NotificationPreferenceRepository", "Java / interfaces", "Domain: Contratos de consulta y persistencia con tipos del contexto")
  Component(repo, "JpaNotificationRepositoryAdapter / JpaNotificationPreferenceRepositoryAdapter", "Java / Spring Boot", "Infrastructure: Registra avisos únicos, intentos y preferencias")
  Component(channels, "WebSocketPushAdapter / EmailNotificationAdapter / AccountNoticeClient", "Java / Spring Boot", "Infrastructure: Entrega aviso sin evidencia privada")
}
Rel(api, app, "Delega caso de uso", "Java")
Rel(consumer, app, "Entrega evento validado", "Java")
Rel(app, rules, "Aplica reglas de dominio", "Java")
Rel(app, ports, "Utiliza contratos del dominio", "Java")
Rel(repo, ports, "Implementa contratos de repositorio", "Java")
Rel(app, channels, "Entrega aviso por canal", "Java")
Rel(bus, consumer, "Entrega eventos y deletion.requested", "AMQP")
Rel(consumer, bus, "Confirma purga de referencias de sesión", "AMQP")
Rel(bff, api, "Consulta/modifica preferencias", "HTTPS / JSON")
Rel(repo, db, "Conserva avisos y preferencias", "SQL / TLS")
Rel(channels, web, "Entrega aviso autenticado", "WSS")
Rel(channels, mail, "Envía mensaje transaccional", "HTTPS / SMTP-TLS")
Rel(channels, identity, "Obtiene enlace efímero para aviso de cuenta", "HTTPS / JSON")
SHOW_LEGEND()
@enduml
