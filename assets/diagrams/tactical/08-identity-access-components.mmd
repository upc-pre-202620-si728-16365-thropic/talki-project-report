flowchart TB
  input["Interface: registro, acceso, renovación y perfil"] --> app["Application: casos de uso de cuenta y acceso"]
  app --> model["Domain: AppUser, RefreshToken y UserRole"]
  app --> security["Infrastructure: Spring Security y JWT"]
  model --> repo["Infrastructure: persistencia de cuentas"]
  repo --> db["PostgreSQL: app_users y refresh_tokens"]
  app --> broker["Infrastructure: RabbitMQ / user.registered"]
  broker --> others["Contextos interesados en el registro"]
  consent["Ampliacion: registro verificable de consentimiento"] -.-> app
