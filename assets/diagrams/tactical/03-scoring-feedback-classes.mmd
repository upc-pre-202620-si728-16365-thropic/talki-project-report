classDiagram
 direction LR
class ScoreResult {
  <<AggregateRoot>>
  -UUID id
  -UUID sessionId
  -Long userId
  -String analysisVersion
  -String rubricVersion
  -VoiceScore score
  -EvaluationEvidence evidence
  -List~String~ recommendations
  -Instant computedAt
  +hasEvidence() boolean
}
class VoiceScore {
  <<ValueObject>>
  -Integer fluency
  -Integer clarity
  -Integer volume
  -Integer vocabulary
  -Integer confidence
  +overall() Integer
}
class EvaluationEvidence {
  <<ValueObject>>
  -UUID sessionId
  -String analysisVersion
  -Map~String,double~ metrics
  -List~String~ availableDimensions
  -List~String~ limitations
  -List~ContextualFinding~ contextualFindings
}
class ContextualFinding {
  <<ValueObject>>
  -String term
  -boolean spoken
  -String evidenceFragment
  -String suggestedAlternative
  -String reason
}
class ScoreCalculator {
  +calculate(EvaluationEvidence evidence, String rubricVersion) VoiceScore
}
ScoreResult "1" *-- "1" VoiceScore : dimensiones
ScoreResult "1" *-- "1" EvaluationEvidence : evidencia conservada
EvaluationEvidence "1" *-- "0..*" ContextualFinding : hallazgos autorizados
ScoreCalculator ..> EvaluationEvidence : interpreta
ScoreCalculator ..> VoiceScore : calcula
