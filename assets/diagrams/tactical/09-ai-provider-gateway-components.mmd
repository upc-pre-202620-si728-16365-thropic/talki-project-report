flowchart TB
    input["Interface: HTTP interno / streaming autorizado"] --> app["AIIntegrationApplicationService"]
    app --> domain["Domain: AIProviderPort + GeminiLiveClient"]
    app --> port["Puerto: Configuracion / SecretResolverPort"]
