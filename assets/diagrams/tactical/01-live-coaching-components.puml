@startuml
!include <C4/C4_Component>
skinparam defaultFontName Arial
skinparam dpi 150
LAYOUT_TOP_DOWN()
title C4 Component Diagram: Live Coaching
Container(ai, "AI Provider Gateway", "Java / Spring Boot", "Fuera del container representado")
Container(bff, "API Gateway / BFF", "HTTPS / JSON", "Fuera del container representado")
Container(identity, "Identity & Access", "Java / Spring Boot", "Fuera del container representado")
Container(sessions, "Practice Session Management", "Java / Spring Boot", "Fuera del container representado")
Container_Boundary(scope, "Live Coaching: proceso Java / Spring Boot") {
  Component(api, "LiveCoachController / LiveTokenResponse", "Java / Spring Boot", "Interface: Valida preparación y cierre del ensayo")
  Component(app, "LiveCoachOrchestrator", "Java / Spring Boot", "Application: Comprueba sesión/consentimiento y coordina credencial/cierre")
  Component(rules, "SessionModeStrategyFactory / estrategias", "Java / Spring Boot", "Domain: Prepara instrucciones según modo y contexto")
  Component(aiClient, "AIProviderGatewayClient", "Java / Spring Boot", "Infrastructure: Solicita credencial por API interna")
  Component(sessionClient, "SessionClosureClient / SessionAccessClient", "Java / Spring Boot", "Infrastructure: Comprueba sesión y confirma evidencia de cierre")
  Component(consentClient, "ConsentVerificationClient", "Java / Spring Boot", "Infrastructure: Consulta autorización vigente")
}
Rel(api, app, "Delega caso de uso", "Java")
Rel(app, rules, "Aplica reglas de dominio", "Java")
Rel(app, aiClient, "Solicita credencial efímera", "Java")
Rel(app, sessionClient, "Comprueba sesión y cierre", "Java")
Rel(app, consentClient, "Verifica consentimiento", "Java")
Rel(bff, api, "Prepara ensayo y entrega cierre", "HTTPS / JSON")
Rel(aiClient, ai, "Solicita credencial efímera", "HTTPS / JSON")
Rel(sessionClient, sessions, "Verifica sesión y confirma cierre", "HTTPS / JSON")
Rel(consentClient, identity, "Verifica consentimiento vigente", "HTTPS / JSON")
SHOW_LEGEND()
@enduml
