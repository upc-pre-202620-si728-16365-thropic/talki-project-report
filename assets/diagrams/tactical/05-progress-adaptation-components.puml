@startuml
!include <C4/C4_Component>
skinparam defaultFontName Arial
skinparam dpi 150
LAYOUT_TOP_DOWN()
title C4 Component Diagram: Progress & Adaptation
Container(bff, "API Gateway / BFF", "HTTPS / JSON", "Fuera del container representado")
ContainerQueue(bus, "Broker de eventos", "RabbitMQ / AMQP", "Fuera del container representado")
ContainerDb(db, "Esquema privado del contexto", "PostgreSQL / TLS", "Fuera del container representado")
Container_Boundary(scope, "Progress & Adaptation: proceso Java / Spring Boot") {
  Component(api, "ProgressController", "Java / Spring Boot", "Interface: Expone dashboard, comparación y plan")
  Component(app, "RecordProgressHandler / UserProgressQueryService / BuildAdaptivePlanHandler", "Java / Spring Boot", "Application: Actualiza historial, compara evidencia y prepara ejercicios")
  Component(rules, "UserProgress / SessionMetrics / AdaptivePlan", "Java / Spring Boot", "Domain: Preserva compatibilidad y referencias de evidencia")
  Component(repo, "UserProgressRepository / SessionMetricsRepository / AdaptivePlanRepository", "Java / Spring Boot", "Infrastructure: Conserva resultados, planes y ejercicios")
  Component(consumer, "ScoringCompletedConsumer", "Java / Spring Boot", "Infrastructure: Recibe evaluación y delega actualización")
}
Rel(api, app, "Delega caso de uso", "Java")
Rel(consumer, app, "Entrega evento validado", "Java")
Rel(app, rules, "Aplica reglas de dominio", "Java")
Rel(app, repo, "Lee y confirma datos del contexto", "Java")
Rel(bff, api, "Consulta progreso o modifica plan", "HTTPS / JSON")
Rel(bus, consumer, "Entrega scoring.completed y deletion.requested", "AMQP")
Rel(consumer, bus, "Confirma purga local", "AMQP")
Rel(repo, db, "Lee y actualiza historial/planes", "SQL / TLS")
SHOW_LEGEND()
@enduml
