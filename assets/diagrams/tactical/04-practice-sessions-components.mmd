flowchart TB
    input["Interface: REST / consentimiento / control Live"] --> app["SessionCommandService / SessionQueryService"]
    app --> domain["Domain: Session + SessionUserContext"]
    app --> port["Puerto: SessionRepository / FeedbackRepository"]
    adapter["Infrastructure: adaptador de session-service"] -. implementa .-> port
    adapter --> resource["Persistencia privada o salida del servicio"]
    app --> integration["Puerto de integracion / eventos"]
    infrastructure["Adaptador autorizado HTTP, WebSocket o RabbitMQ"] -. implementa .-> integration
    infrastructure --> external["Identity / Live Coaching / almacenamiento privado"]
