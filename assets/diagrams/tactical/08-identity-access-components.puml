@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam componentStyle uml2
skinparam backgroundColor white
skinparam componentBackgroundColor #EAF0FF
skinparam componentBorderColor #1749B5
skinparam ArrowColor #536177
skinparam packageBackgroundColor #F7F9FD
skinparam dpi 130
title
UML Component Diagram: Identity & Access
Descomposición en User Service (Java / Spring Boot)
end title
database "PostgreSQL:\napp_users" as db <<Externo>> #EEEEEE
queue "RabbitMQ:\nuser.registered" as others <<Externo>> #EEEEEE
package "Bounded Context:\nIdentity & Access" {
  package "Interface Layer" {
    component "Interface:\nAuthController\n[Java / Spring Boot]" as input
  }
  package "Application Layer" {
    component "Application:\nAuthService\n[Java / Spring Boot]" as app
    interface "Application:\nUserRegisteredEventPublisher" as port
  }
  package "Domain Layer" {
    component "Domain:\nAppUser\ny UserRole\n[Java / Spring Boot]" as model
  }
  package "Infrastructure Layer" {
    component "Infrastructure:\nPasswordEncoder\ny JwtTokenProvider\n[Java / Spring Boot]" as security
    component "Infrastructure:\nAppUserRepository\n[Java / Spring Boot]" as repo
    component "Infrastructure:\nRabbitUserRegisteredPublisher\n[Java / Spring Boot]" as adapter
  }
}
input --> app : solicita registro o acceso / Java
app --> model : aplica reglas de cuenta / Java
app --> security : verifica contraseña y prepara token / Java
app --> repo : consulta o conserva usuario / Java
repo --> db : persistencia / SQL
app --> port : solicita publicar cuenta registrada / Java
adapter ..|> port : realiza contrato
adapter --> others : eventos / AMQP
note bottom
Ampliación: RefreshToken y registro de consentimiento
end note
legend bottom
Icono UML: componente; círculo: interfaz.
Flecha continua: interacción dirigida.
Relación a interfaz: contrato proporcionado.
Externo: fuera del proceso representado.
Propuesto: ampliación pendiente.
Los casos de uso nombran responsabilidades de diseño;
no acreditan nuevas clases ni servicios desplegados.
endlegend
@enduml
