@startuml
!include <C4/C4_Component>
skinparam defaultFontName Arial
skinparam dpi 150
LAYOUT_TOP_DOWN()
title C4 Component Diagram: Identity & Access
Container(bff, "API Gateway / BFF", "HTTPS / JSON", "Fuera del container representado")
ContainerQueue(bus, "Broker de eventos", "RabbitMQ / AMQP", "Fuera del container representado")
ContainerDb(db, "Esquema privado del contexto", "PostgreSQL / TLS", "Fuera del container representado")
Container(sessions, "Practice Session Management", "Java / Spring Boot", "Fuera del container representado")
Container_Boundary(scope, "Identity & Access: proceso Java / Spring Boot") {
  Component(api, "AuthController / ProfileController / VoiceConsentController", "Java / Spring Boot", "Interface: Recibe acceso, perfil, recuperación y consentimiento")
  Component(app, "AuthService / TokenSessionService / ConsentCommandService / PasswordRecoveryService / EmailVerificationService", "Java / Spring Boot", "Application: Coordina cuenta, tokens y autorizaciones")
  Component(rules, "AppUser / RefreshToken / VoiceConsent / PasswordResetRequest / EmailVerificationRequest", "Java / Spring Boot", "Domain: Mantiene identidad y vigencia/retiro/consumo")
  Component(repo, "AppUserRepository / RefreshTokenRepository / VoiceConsentRepository / PasswordResetRepository / EmailVerificationRepository", "Java / Spring Boot", "Infrastructure: Conserva registros privados de cuenta")
  Component(security, "PasswordEncoder / JwtTokenProvider", "Java / Spring Boot", "Infrastructure: Protege contraseña y firma acceso")
  Component(publisher, "RabbitUserRegisteredPublisher / AccountNoticePublisher", "Java / Spring Boot", "Infrastructure: Despacha avisos de cuenta sin secretos")
}
Rel(api, app, "Delega caso de uso", "Java")
Rel(app, rules, "Aplica reglas de dominio", "Java")
Rel(app, repo, "Lee y confirma datos del contexto", "Java")
Rel(app, security, "Protege contraseña y acceso", "Java")
Rel(app, publisher, "Registra salida para despacho", "Java")
Rel(bff, api, "Solicita acceso y perfil", "HTTPS / JSON")
Rel(sessions, api, "Verifica consentimiento vigente", "HTTPS / JSON")
Rel(repo, db, "Lee y conserva cuenta/tokens/consentimiento", "SQL / TLS")
Rel(publisher, bus, "Publica registro y aviso de cuenta", "AMQP")
SHOW_LEGEND()
@enduml
