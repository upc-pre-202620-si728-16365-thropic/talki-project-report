@startuml
!include <C4/C4_Component>
skinparam defaultFontName Arial
skinparam dpi 150
LAYOUT_TOP_DOWN()
title C4 Component Diagram: Practice Session Management
Container(bff, "API Gateway / BFF", "HTTPS / JSON", "Fuera del container representado")
ContainerQueue(bus, "Broker de eventos", "RabbitMQ / AMQP", "Fuera del container representado")
ContainerDb(db, "Esquema privado del contexto", "PostgreSQL / TLS", "Fuera del container representado")
Container(identity, "Identity & Access", "Java / Spring Boot", "Fuera del container representado")
ContainerDb(store, "Material privado", "Almacenamiento de objetos", "Fuera del container representado")
Container(live, "Live Coaching", "Java / Spring Boot", "Fuera del container representado")
Container(scoring, "Scoring & Feedback", "Java / Spring Boot", "Fuera del container representado")
Container(sharing, "Sharing & Retention", "Java / Spring Boot", "Fuera del container representado")
Container_Boundary(scope, "Practice Session Management: proceso Java / Spring Boot") {
  Component(api, "SessionController", "Java / Spring Boot", "Interface: Recibe preparación, consultas, material y cierre")
  Component(app, "SessionCommandService / SessionQueryService", "Java / Spring Boot", "Application: Coordina escritura y consulta de prácticas")
  Component(acl, "SessionContextFacade", "Java / Spring Boot", "Application: Adapta identidad externa al lenguaje de sesión")
  Component(rules, "Session / PracticeEvidence / Feedback / configuración / material", "Java / Spring Boot", "Domain: Controla estados, evidencia y límites del ensayo")
  Component(repo, "SessionRepository / FeedbackRepository / MaterialRepository", "Java / Spring Boot", "Infrastructure: Conserva evidencia y referencias de material privado")
  Component(storage, "PrivateMaterialStorageAdapter", "Java / Spring Boot", "Infrastructure: Almacena o purga el archivo autorizado")
  Component(messaging, "UserRegisteredConsumer / SessionFinalizedPublisher", "Java / Spring Boot", "Infrastructure: Actualiza proyección y despacha cierre confirmado")
  Component(consentClient, "ConsentVerificationClient / IdentityProfileClient", "Java / Spring Boot", "Infrastructure: Verifica consentimiento y obtiene perfil vigente de Identity")
}
Rel(api, app, "Delega caso de uso", "Java")
Rel(messaging, app, "Entrega evento validado", "Java")
Rel(app, rules, "Aplica reglas de dominio", "Java")
Rel(app, repo, "Lee y confirma datos del contexto", "Java")
Rel(app, consentClient, "Verifica consentimiento", "Java")
Rel(acl, consentClient, "Obtiene perfil vigente", "Java")
Rel(app, storage, "Gestiona material autorizado", "Java")
Rel(app, acl, "Adapta identidad externa", "Java")
Rel(app, messaging, "Registra salida o confirmación", "Java")
Rel(live, api, "Comprueba sesión y confirma cierre", "HTTPS / JSON")
Rel(scoring, api, "Verifica acceso al reporte", "HTTPS / JSON")
Rel(sharing, api, "Confirma bloqueo y pertenencia", "HTTPS / JSON")
Rel(bff, api, "Crea o consulta práctica", "HTTPS / JSON")
Rel(repo, db, "Persiste sesión y outbox", "SQL / TLS")
Rel(storage, store, "Almacena o elimina material", "HTTPS")
Rel(bus, messaging, "Entrega user.registered y deletion.requested", "AMQP")
Rel(messaging, bus, "Publica cierre y confirmación de purga", "AMQP")
Rel(consentClient, identity, "Comprueba autorización actual", "HTTPS / JSON")
SHOW_LEGEND()
@enduml
