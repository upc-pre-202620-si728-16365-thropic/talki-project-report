flowchart TB
    input["Interface: REST preferencias / consumidores de eventos"] --> app["ScoreNotificationConsumer / AchievementNotificationConsumer"]
    app --> domain["Domain: NotificationPushService + consumidores"]
    app --> port["Puerto: NotificationDeliveryPort"]
    adapter["Infrastructure: adaptador de notification-service"] -. implementa .-> port
    adapter --> resource["Persistencia privada o salida del servicio"]
    app --> integration["Puerto de integracion / eventos"]
    infrastructure["Adaptador autorizado HTTP, WebSocket o RabbitMQ"] -. implementa .-> integration
    infrastructure --> external["EmailSenderAdapter / proveedor correo"]
