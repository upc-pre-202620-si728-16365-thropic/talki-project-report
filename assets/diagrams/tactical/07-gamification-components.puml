@startuml
!include <C4/C4_Component>
skinparam defaultFontName Arial
skinparam dpi 150
LAYOUT_TOP_DOWN()
title C4 Component Diagram: Gamification
Container(bff, "API Gateway / BFF", "HTTPS / JSON", "Fuera del container representado")
ContainerQueue(bus, "Broker de eventos", "RabbitMQ / AMQP", "Fuera del container representado")
ContainerDb(db, "Esquema privado del contexto", "PostgreSQL / TLS", "Fuera del container representado")
Container_Boundary(scope, "Gamification: proceso Java / Spring Boot") {
  Component(api, "GamificationController", "Java / Spring Boot", "Interface: Expone racha y ranking voluntario")
  Component(app, "RecordGamificationHandler / GamificationQueryService", "Java / Spring Boot", "Application: Registra contribuciones únicas y organiza consultas")
  Component(rules, "UserStreak / Achievement / PracticeContribution / AchievementRuleService", "Java / Spring Boot", "Domain: Aplica validez, zona horaria y reglas versionadas")
  Component(ports, "UserStreakRepository / AchievementRepository / PracticeContributionRepository", "Java / interfaces", "Domain: Contratos de consulta y persistencia con tipos del contexto")
  Component(repo, "JpaUserStreakRepositoryAdapter / JpaAchievementRepositoryAdapter / JpaPracticeContributionRepositoryAdapter", "Java / Spring Boot", "Infrastructure: Conserva progreso lúdico sin duplicar XP")
  Component(messaging, "ScoringCompletedConsumer / AchievementUnlockedPublisher", "Java / Spring Boot", "Infrastructure: Recibe práctica evaluada y comunica logros")
}
Rel(api, app, "Delega caso de uso", "Java")
Rel(messaging, app, "Entrega evento validado", "Java")
Rel(app, rules, "Aplica reglas de dominio", "Java")
Rel(app, ports, "Utiliza contratos del dominio", "Java")
Rel(repo, ports, "Implementa contratos de repositorio", "Java")
Rel(app, messaging, "Registra salida o confirmación", "Java")
Rel(bff, api, "Consulta rachas y ranking", "HTTPS / JSON")
Rel(bus, messaging, "Entrega scoring.completed y deletion.requested", "AMQP")
Rel(messaging, bus, "Publica logro o confirma purga", "AMQP")
Rel(repo, db, "Persiste reconocimiento y contribuciones", "SQL / TLS")
SHOW_LEGEND()
@enduml
