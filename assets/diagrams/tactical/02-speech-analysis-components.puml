@startuml
!include <C4/C4_Component>
skinparam defaultFontName Arial
skinparam dpi 150
LAYOUT_TOP_DOWN()
title C4 Component Diagram: Speech Analysis
ContainerQueue(bus, "Broker de eventos", "RabbitMQ / AMQP", "Fuera del container representado")
ContainerDb(db, "Esquema privado del contexto", "PostgreSQL / TLS", "Fuera del container representado")
Container(scoring, "Scoring & Feedback Worker", "Java / Spring Boot", "Fuera del container representado")
Container_Boundary(scope, "Speech Analysis: proceso Java / Spring Boot") {
  Component(consumer, "SessionLiveFinalizedConsumer", "Java / Spring Boot", "Infrastructure: Recibe el contrato AMQP y confirma tras commit")
  Component(app, "AnalyzeSpeechHandler", "Java / Spring Boot", "Application: Coordina análisis y reintento sobre el mismo job")
  Component(rules, "AnalysisJob / FillerDetector / AcousticEvidenceAnalyzer / ContextualEvidenceAnalyzer", "Java / Spring Boot", "Domain: Controla estado y analiza evidencia acústica/contextual")
  Component(api, "AnalysisJobController", "Java / Spring Boot", "Interface: Consulta estado y solicita reintento interno")
  Component(repo, "AnalysisJobRepository / AnalysisResultOutbox", "Java / Spring Boot", "Infrastructure: Conserva job y resultado durable")
  Component(publisher, "FillerAnalyzedPublisher", "Java / Spring Boot", "Infrastructure: Despacha métricas confirmadas por RabbitMQ")
}
Rel(api, app, "Delega caso de uso", "Java")
Rel(consumer, app, "Entrega evento validado", "Java")
Rel(app, rules, "Aplica reglas de dominio", "Java")
Rel(app, repo, "Lee y confirma datos del contexto", "Java")
Rel(app, publisher, "Registra salida para despacho", "Java")
Rel(bus, consumer, "Entrega session.live.finalized", "AMQP")
Rel(scoring, api, "Consulta job o solicita reintento", "HTTPS / JSON")
Rel(repo, db, "Conserva job y outbox", "SQL / TLS")
Rel(publisher, bus, "Publica fillers.analyzed", "AMQP")
SHOW_LEGEND()
@enduml
